<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sfondo"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- GridLayout dei bottoni -->
    <GridLayout
        android:id="@+id/gridPokemonTypes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:padding="12dp"
        android:useDefaultMargins="true">

        <!-- NORMALE -->
        <Button
            android:id="@+id/button_normale"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#ABAAA6"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Normale"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- FUOCO -->
        <Button
            android:id="@+id/button_fuoco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#ED8899"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Fuoco"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- ACQUA -->
        <Button
            android:id="@+id/button_acqua"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#B3D4E6"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Acqua"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- ERBA -->
        <Button
            android:id="@+id/button_erba"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#CEE9AD"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Erba"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- ELETTRO -->
        <Button
            android:id="@+id/button_elettro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#F6EBA9"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Elettro"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- GHIACCIO -->
        <Button
            android:id="@+id/button_ghiaccio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#D0EDE2"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Ghiaccio"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- LOTTA -->
        <Button
            android:id="@+id/button_lotta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#EDBF99"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Lotta"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- VELENO -->
        <Button
            android:id="@+id/button_veleno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#C7BECC"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Veleno"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- TERRA -->
        <Button
            android:id="@+id/button_terra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#E2DCA1"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Terra"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- VOLANTE -->
        <Button
            android:id="@+id/button_volante"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#C9DADC"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Volante"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- PSICO -->
        <Button
            android:id="@+id/button_psico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#FBB9FF"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Psico"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- COLEOTTERO -->
        <Button
            android:id="@+id/button_coleottero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#F1FABF"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Coleottero"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- ROCCIA -->
        <Button
            android:id="@+id/button_roccia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#EDEACC"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Roccia"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- SPETTRO -->
        <Button
            android:id="@+id/button_spettro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#C4AAF8"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Spettro"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- DRAGO -->
        <Button
            android:id="@+id/button_drago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#A4B0CE"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Drago"
            android:textColor="@color/white"
            android:textColorLink="#3E46BA"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- BUIO -->
        <Button
            android:id="@+id/button_buio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#999191"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Buio"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- ACCIAIO -->
        <Button
            android:id="@+id/button_acciaio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#E9E4E4"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Acciaio"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- FOLLETTO -->
        <Button
            android:id="@+id/button_folletto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_pokemon_button"
            android:backgroundTint="#F6BDEE"
            android:elevation="6dp"
            android:minHeight="48dp"
            android:paddingVertical="12dp"
            android:text="Folletto"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="normal" />

    </GridLayout>

    <!-- TextView separato sotto i bottoni-->

    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cerca il pokèmon più forte con questo tipo..."
        android:inputType="text"
        android:textSize="14sp"
        android:visibility="invisible" />

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/textMessaggio"
        style="@style/TextViewCool"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="SELEZIONA UN TIPO POKÈMON"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="normal" />

</LinearLayout>
