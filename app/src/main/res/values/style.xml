<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Stile TextView accattivante -->
    <style name="TextViewCool" >
        <!-- Colore del testo -->
        <item name="android:textColor">#000080</item>

        <!-- Dimensione del testo -->
        <item name="android:textSize">20sp</item>

        <!-- Grassetto + leggermente arrotondato -->
        <item name="android:textStyle">bold</item>

        <!-- Ombra testo per effetto 3D leggero -->
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>

        <!-- Allineamento e padding -->
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>

        <!-- Background con gradient accattivante -->
        <item name="android:background">@drawable/textview_background</item>
    </style>

</resources>